#!/bin/bash
# Pre-push: every push to main is a production deploy to six apps, so the
# unit tests and the kit check (invariants + baseline screenshots) must pass
# first. Installed by scripts/install-hooks.sh (core.hooksPath=.githooks).
# Skip once, knowingly: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
NODE=(/usr/local/bin/mise exec node@22 -- node)
command -v /usr/local/bin/mise >/dev/null || NODE=(node)
[ -d node_modules ] || { echo "pre-push: run \`mise exec node@22 -- npm install\` first (or git push --no-verify)"; exit 1; }
if [ -d test ]; then echo "pre-push: unit tests"; "${NODE[@]}" --test test/*.test.mjs; fi
echo "pre-push: kit check (≈70s)"
"${NODE[@]}" scripts/check.mjs
