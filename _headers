# Workers Static Assets header rules, applied top to bottom; `! Name`
# detaches a header an earlier matching rule set.
#
# Unversioned files (the root): always latest, revalidated on every use.
/*
  Cache-Control: public, no-cache

/fonts/*
  Access-Control-Allow-Origin: *

# Pinned releases (scripts/release.mjs) and vendored third-party builds:
# the path names the version, so the bytes never change. Cached for a year,
# and CORS-readable so apps can load them with integrity="sha384-…"
# crossorigin="anonymous".
/v/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# The pointer to the newest release moves with every release.
/v/current.json
  ! Cache-Control
  Cache-Control: public, no-cache
